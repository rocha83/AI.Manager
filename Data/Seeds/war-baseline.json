              "cases": ["verde-build"]
            }
          }
        ]
      }
    ],
    "scenarios": [
      {
        "key": "azul-build",
        "title": "L1 azul — repositorio generico com ORM",
        "prompt": "Crie no backend .NET C# uma consulta de dados em uma tabela (ex.: reembolsos corporativos) usando repositorio generico com ORM. Escopo SOMENTE backend de dados (sem frontend, sem API). Premissas: backend .NET C#. Divida a implementacao em etapas, dialogo em pt-br. Critério de aceite, solução implementada, codificada em arquivos no disco e compilando: crie arquivos .cs com as classes, interfaces e repositorios.",
        "systemPrompt": "Voce e um arquiteto desenvolvedor backend C# senior (DDD/SOLID). Execute a tarefa no workspace usando as tools reais; nao narre a acao sem executa-la.",
        "workspace": {
          "template": "/tmp/opencode/aim-belts/{case}",
          "clean": true
        },
        "model": {
          "role": "build",
          "temperature": 0.3,
          "thinking": "off",
          "maxTokens": 8192
        },
        "tools": {
          "mode": "required",
          "allow": ["write", "read", "edit", "shell", "glob", "grep"],
          "toolChoice": "write"
        },
        "loop": {
          "maxTurns": 12,
          "maxNudges": 2,
          "review": true,
          "stallLimit": 3
        },
        "assertions": [
          {
            "type": "fileCountAtLeast",
            "value": 3,
            "required": true
          },
          {
            "type": "fileExtensionCountAtLeast",
            "ext": ".cs",
            "value": 2,
            "required": true
          },
          {
            "type": "totalCharsAtLeast",
            "value": 2000,
            "required": true
          },
          {
            "type": "noProseBeforeTool",
            "required": false
          }
        ],
        "tags": ["L1", "build", "azul", "orm"],
        "weight": 1
      },
      {
        "key": "verde-build",
        "title": "L1 verde — dominio + banco SQL de CRUD",
        "prompt": "Especifique o dominio backend C# de um CRUD de reembolsos corporativos (entidades, value objects, regras de aprovacao por faixa de valor) e o banco de dados SQL: DDL das tabelas, indices, constraints e seeds. Valide CPF e CNPJ. Escopo: dominio + banco SQL. Premissas: backend .NET C#. Divida a implementacao em etapas, dialogo em pt-br. Critério de aceite, solução implementada, codificada em arquivos no disco e compilando: arquivos .cs (entidades/VOs) e .sql (DDL).",
        "systemPrompt": "Voce e um arquiteto desenvolvedor backend C# senior (DDD/SOLID) com foco em modelagem SQL. Execute a tarefa no workspace usando as tools reais.",
        "workspace": {
          "template": "/tmp/opencode/aim-belts/{case}",
          "clean": true
        },
        "model": {
          "role": "build",
          "temperature": 0.3,
          "thinking": "off",
          "maxTokens": 8192
        },
        "tools": {
          "mode": "required",
          "allow": ["write", "read", "edit", "shell", "glob", "grep"],
          "toolChoice": "write"
        },
        "loop": {
          "maxTurns": 12,
          "maxNudges": 2,
          "review": true,
          "stallLimit": 3
        },
        "assertions": [
          {
            "type": "fileCountAtLeast",
            "value": 3,
            "required": true
          },
          {
            "type": "fileExtensionCountAtLeast",
            "ext": ".cs",
            "value": 2,
            "required": true
          },
          {
            "type": "fileExtensionCountAtLeast",
            "ext": ".sql",
            "value": 1,
            "required": true
          },
          {
            "type": "totalCharsAtLeast",
            "value": 2500,
            "required": true
          }
        ],
        "tags": ["L1", "build", "verde", "sql"],
        "weight": 1
      }
    ]
